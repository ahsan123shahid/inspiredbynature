{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "https://inspiredbynature-backend-production.up.railway.app/assets/$1" },
    { "source": "/api/(.*)", "destination": "https://inspiredbynature-backend-production.up.railway.app/api/$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
