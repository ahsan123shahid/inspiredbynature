# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/inspired_by_nature_v2

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Inspired by Nature
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# EasyPaisa (sandbox)
EASYPAISA_MERCHANT_ID=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_SANDBOX=true

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
